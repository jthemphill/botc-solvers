{
  "name": "botc-solver-typescript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "search:bmr": "bun scripts/search-bmr.ts",
